---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />

		<main>
	<article>
		<header class="article-header">
			<p class="eyebrow">✦ WRITING</p>

			<h1>{title}</h1>

			<p class="article-description">
				{description}
			</p>

			<div class="date">
				<FormattedDate date={pubDate} />

				{
					updatedDate && (
						<span class="last-updated-on">
							· Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</div>
		</header>

		{
			heroImage && (
				<div class="hero-image">
					<Image
						width={1200}
						height={600}
						src={heroImage}
						alt=""
					/>
				</div>
			)
		}

		<div class="prose">
			<slot />
		</div>
	</article>
</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 880px;
		margin: 3rem auto 5rem;
		padding: 4rem 4.5rem 6rem;
		background: rgba(255, 253, 248, 0.82);
		border: 1px solid rgba(74, 93, 75, 0.12);
		border-radius: 24px;
		box-shadow: 0 20px 60px rgba(48, 66, 50, 0.08);
	}

	.article-header {
		max-width: 720px;
		margin: 0 auto 3.5rem;
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		color: #788671;
	}

	.article-header h1 {
		margin: 0 0 1.25rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 3rem;
		font-weight: 400;
		line-height: 1.25;
		color: #304137;
	}

	.article-description {
		max-width: 600px;
		margin: 0 auto 1.25rem;
		line-height: 1.8;
		color: #6c756b;
	}

	.date {
		font-size: 0.85rem;
		color: #929a90;
	}

	.last-updated-on {
		font-style: italic;
	}

	.hero-image {
		max-width: 100%;
		margin: 0 auto 3.5rem;
	}

	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 16px;
		box-shadow: 0 12px 35px rgba(48, 66, 50, 0.1);
	}

	.prose {
		width: 680px;
		max-width: 100%;
		margin: 0 auto;
		color: #4d564d;
		font-size: 1.05rem;
		line-height: 1.95;
	}

	.prose :global(h2) {
		margin-top: 3rem;
		margin-bottom: 1rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.8rem;
		font-weight: 400;
		color: #35463a;
	}

	.prose :global(h3) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		font-size: 1.3rem;
		color: #405244;
	}

	.prose :global(p) {
		margin: 1.5rem 0;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 1.5rem 0;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin: 0.5rem 0;
	}

	.prose :global(a) {
		color: #526d55;
		text-underline-offset: 3px;
	}

	.prose :global(blockquote) {
		margin: 2rem 0;
		padding: 1rem 1.5rem;
		border-left: 3px solid #91a08a;
		background: #f0f3ec;
		color: #667062;
	}

	.prose :global(code) {
		padding: 0.15em 0.4em;
		border-radius: 4px;
		background: #edf0e9;
		color: #536452;
	}

	.prose :global(pre) {
		margin: 2rem 0;
		padding: 1.5rem;
		overflow-x: auto;
		border-radius: 12px;
		background: #26332b;
	}

	.prose :global(pre code) {
		padding: 0;
		background: transparent;
	}

	@media (max-width: 700px) {
		main {
			margin: 0;
			padding: 3rem 1.5rem 5rem;
			border: none;
			border-radius: 0;
			box-shadow: none;
		}

		.article-header h1 {
			font-size: 2.4rem;
		}

		.prose {
			font-size: 1rem;
		}
	}
</style>