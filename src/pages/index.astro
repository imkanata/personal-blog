---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<!-- Hero / Introduction -->
			<section class="intro">
				<div class="intro-text">
					<p class="eyebrow">✦ RESEARCH · CODE · LIFE</p>

					<h2>Siyu Ding / テイ　シウ</h2>

					<p class="welcome">
						Welcome to my little corner of the internet.
					</p>

					<p class="bio">
						I am currently a research student at&nbsp
						<strong>Ochanomizu University</strong> in Tokyo, Japan.
					</p>

					<p class="bio">
						I write about research, programming, learning,
						and small moments in life.
					</p>

					<div class="links">
						<a
							href="https://github.com/imkanata"
							target="_blank"
							rel="noopener noreferrer"
						>
							GitHub ↗
						</a>

						<a href="/blog">
							Read my blog →
						</a>

						<a href="mailto:furudoerk@gmail.com">
							Email ↗
						</a>
					</div>
				</div>

				<div class="profile-image">
					<img
						src="/profile.jpg"
						alt="Portrait of Siyu Ding"
					/>
				</div>
			</section>

			<div class="divider">
				<span>❦</span>
			</div>

			<!-- About -->
			<section class="about">
				<p class="section-label">01 / ABOUT</p>

				<h2>A little about me</h2>

				<p>
					I have a background in computer science and enjoy exploring how
					programming and data can be used to understand real-world problems.
					I am currently a research student at Ochanomizu University, working in
					<a
						href="https://sites.google.com/site/tsubasakohyama/%E7%A5%9E%E5%B1%B1%E7%A0%94%E7%A9%B6%E5%AE%A4"
						target="_blank"
						rel="noopener noreferrer"
					>
						Professor Tsubasa Kohyama's Laboratory
					</a>.
					I am currently interested in algorithms, Python, and data analysis,
					and I am beginning to explore research in meteorology and climate data.
				</p>
			</section>

			<!-- Education -->
			<section class="education">
				<p class="section-label">02 / EDUCATION</p>

				<h2>Where I study</h2>

				<div class="timeline">
					<div class="timeline-item">
						<div class="time">2026 —</div>

						<div>
							<h3>Ochanomizu University</h3>
							<p>Research Student · Science</p>
						</div>
					</div>

					<div class="timeline-item">
						<div class="time">2021 — 2025</div>

						<div>
							<h3>
								Hebei Normal University of Science &
								Technology
							</h3>
							<p>B.Sc. in Computer Science</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Interests -->
			<section class="interests">
				<p class="section-label">03 / INTERESTS</p>

				<h2>Research & Interests</h2>

				<div class="tags">
					<span>Algorithms</span>
					<span>Python</span>
					<span>Data Analysis</span>
					<span>Meteorology</span>
					<span>Climate Data</span>
					<span>Scientific Computing</span>
				</div>
			</section>

			<!-- Projects -->
			<section class="projects">
				<p class="section-label">04 / PROJECTS</p>

				<h2>Things I build</h2>

				<div class="project-card">
					<span class="project-number">01</span>

					<div>
						<h3>More projects coming soon.</h3>

						<p>
							I am currently working, learning and collecting
							ideas for future projects.
						</p>
					</div>
				</div>
			</section>

			<!-- Closing -->
			<section class="closing">
				<p>Thanks for stopping by.</p>

				<a href="/blog">Explore my writing →</a>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background:
			radial-gradient(
				circle at top left,
				rgba(202, 220, 195, 0.45),
				transparent 32%
			),
			radial-gradient(
				circle at bottom right,
				rgba(224, 213, 188, 0.35),
				transparent 30%
			),
			#f5f3ed;
		color: #344338;
	}

	main {
		max-width: 960px;
		margin: 2.5rem auto 5rem;
		padding: 4.5rem 5rem 5.5rem;
		background: rgba(255, 253, 248, 0.8);
		border: 1px solid rgba(74, 93, 75, 0.12);
		border-radius: 24px;
		box-shadow: 0 20px 60px rgba(48, 66, 50, 0.08);
	}

	section {
		margin-bottom: 5rem;
	}

	/* =====================
	   INTRO
	===================== */

	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 250px;
		gap: 3.5rem;
		align-items: center;
		margin-bottom: 4.5rem;
	}

	.intro-text {
		max-width: 580px;
	}

	.profile-image {
		display: flex;
		justify-content: flex-end;
		align-items: center;
	}

	.profile-image img {
		display: block;
		width: 240px;
		height: 320px;
		object-fit: cover;
		object-position: center;
		border-radius: 14px;
		box-shadow: 0 14px 35px rgba(48, 66, 50, 0.13);
	}

	.eyebrow,
	.section-label {
		margin: 0 0 1rem;
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		color: #788671;
	}

	.intro h1 {
		margin: 0 0 1.25rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.5rem, 7vw, 5.2rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 1;
		color: #304137;
	}

	.welcome {
		max-width: 470px;
		margin: 0 0 1.8rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.25rem;
		font-style: italic;
		line-height: 1.6;
		color: #6e7d70;
	}

	.bio {
		max-width: 560px;
		margin: 0 0 0.8rem;
		font-size: 1rem;
		line-height: 1.9;
		color: #5f695f;
	}

	.bio strong {
		color: #3d5142;
		font-weight: 500;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.links a {
		padding: 0.6rem 1rem;
		border: 1px solid #cbd5c7;
		border-radius: 999px;
		color: #4b614d;
		text-decoration: none;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}

	.links a:hover {
		background: #e7eee1;
		transform: translateY(-2px);
	}

	/* =====================
	   DIVIDER
	===================== */

	.divider {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 4.5rem;
		color: #91a08a;
	}

	.divider::before,
	.divider::after {
		flex: 1;
		height: 1px;
		background: #d7ded2;
		content: "";
	}

	/* =====================
	   GENERAL
	===================== */

	h2 {
		margin: 0 0 1.25rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 2.1rem;
		font-weight: 400;
		letter-spacing: -0.03em;
		color: #35463a;
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: 1rem;
		font-weight: 500;
		color: #405244;
	}

	section > p:not(.section-label) {
		max-width: 700px;
		line-height: 1.9;
		color: #626b62;
	}

	.about a {
		color: #526b55;
		text-decoration: underline;
		text-decoration-color: #bdc8b8;
		text-underline-offset: 3px;
	}

	/* =====================
	   EDUCATION
	===================== */

	.timeline {
		border-left: 1px solid #ccd6c7;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 2rem;
		padding: 0 0 2.5rem 2rem;
		position: relative;
	}

	.timeline-item::before {
		position: absolute;
		left: -5px;
		top: 0.4rem;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #82967b;
		content: "";
	}

	.timeline-item:last-child {
		padding-bottom: 0;
	}

	.time {
		font-size: 0.82rem;
		color: #899387;
	}

	.timeline-item p {
		margin: 0;
		color: #747d73;
	}

	/* =====================
	   INTERESTS
	===================== */

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.tags span {
		padding: 0.6rem 1rem;
		border-radius: 999px;
		background: #e7eee1;
		color: #5b6e57;
		font-size: 0.85rem;
	}

	.tags span:nth-child(2n) {
		background: #edf0e8;
	}

	.tags span:nth-child(3n) {
		background: #ece6d9;
		color: #75654d;
	}

	/* =====================
	   PROJECTS
	===================== */

	.project-card {
		display: grid;
		grid-template-columns: 70px 1fr;
		gap: 1.5rem;
		padding: 2rem;
		background: #f0f3ec;
		border: 1px solid #dce4d7;
		border-radius: 16px;
	}

	.project-number {
		font-family: Georgia, serif;
		font-size: 1.8rem;
		color: #84967e;
	}

	.project-card p {
		margin: 0;
		line-height: 1.8;
		color: #70796f;
	}

	/* =====================
	   CLOSING
	===================== */

	.closing {
		margin-bottom: 0;
		padding-top: 2rem;
		text-align: center;
	}

	.closing p {
		margin-bottom: 1rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.4rem;
		font-style: italic;
		color: #61705f;
	}

	.closing a {
		color: #4c634f;
		text-decoration: none;
	}

	.closing a:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	/* =====================
	   MOBILE
	===================== */

	@media (max-width: 700px) {
		main {
			margin: 0;
			padding: 3.5rem 1.5rem 5rem;
			border: none;
			border-radius: 0;
			box-shadow: none;
		}

		section {
			margin-bottom: 4rem;
		}

		.intro {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.profile-image {
			justify-content: flex-start;
		}

		.profile-image img {
			width: 200px;
			height: 270px;
		}

		.intro h1 {
			font-size: 4rem;
		}

		.timeline-item {
			grid-template-columns: 1fr;
			gap: 0.6rem;
			padding-left: 1.5rem;
		}

		.project-card {
			grid-template-columns: 1fr;
		}
	}
</style>