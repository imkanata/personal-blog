---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<section class="intro">
				<p class="eyebrow">✦ RESEARCH · CODE · LIFE</p>

				<h1>Siyu Ding</h1>

				<p class="welcome">
					Welcome to my little corner of the internet.
				</p>

				<p class="bio">
					I am currently a research student at
					<strong>Ochanomizu University</strong> in Tokyo, Japan.
				</p>

				<p class="bio">
					I write about research, programming, learning,
					and small moments in life.
				</p>

				<div class="links">
					<a
						href="https://github.com/imkanata"
						target="_blank"
					>
						GitHub ↗
					</a>

					<a href="/blog">
						Read my blog →
					</a>

					<a href="mailto:furudoerk@gmail.com">
						Email ↗
					</a>
				</div>
			</section>

			<div class="divider">
				<span>❦</span>
			</div>

			<section class="about">
				<p class="section-label">01 / ABOUT</p>

				<h2>A little about me</h2>

				<p>
					I enjoy exploring computer science and building
					things with code. I am especially interested in
					algorithms, Python, and data analysis.
				</p>
			</section>

			<section class="education">
				<p class="section-label">02 / EDUCATION</p>

				<h2>Where I study</h2>

				<div class="timeline">
					<div class="timeline-item">
						<div class="time">2026 —</div>

						<div>
							<h3>Ochanomizu University</h3>
							<p>Research Student · Tokyo, Japan</p>
						</div>
					</div>

					<div class="timeline-item">
						<div class="time">2023 — 2026</div>

						<div>
							<h3>
								Hebei Normal University of Science &
								Technology
							</h3>
							<p>B.Sc. in Computer Science</p>
						</div>
					</div>
				</div>
			</section>

			<section class="interests">
				<p class="section-label">03 / INTERESTS</p>

				<h2>Things I am exploring</h2>

				<div class="tags">
					<span>Algorithms</span>
					<span>Python</span>
					<span>Data Analysis</span>
					<span>Computer Science</span>
					<span>Research</span>
					<span>Learning</span>
				</div>
			</section>

			<section class="projects">
				<p class="section-label">04 / PROJECTS</p>

				<h2>Things I build</h2>

				<div class="project-card">
					<span class="project-number">01</span>

					<div>
						<h3>More projects coming soon.</h3>

						<p>
							I am currently working, learning and collecting
							ideas for future projects.
						</p>
					</div>
				</div>
			</section>

			<section class="closing">
				<p>Thanks for stopping by.</p>

				<a href="/blog">Explore my writing →</a>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		background:
			radial-gradient(
				circle at top left,
				rgba(202, 220, 195, 0.55),
				transparent 32%
			),
			radial-gradient(
				circle at bottom right,
				rgba(224, 213, 188, 0.45),
				transparent 30%
			),
			#f5f3ed;
		color: #344338;
	}

	main {
		max-width: 880px;
		margin: 3rem auto 5rem;
		padding: 5rem 4.5rem 6rem;
		background: rgba(255, 253, 248, 0.78);
		border: 1px solid rgba(74, 93, 75, 0.12);
		border-radius: 24px;
		box-shadow: 0 20px 60px rgba(48, 66, 50, 0.08);
	}

	section {
		margin-bottom: 5.5rem;
	}

	/* Intro */

	.intro {
		margin-bottom: 4rem;
	}

	.eyebrow,
	.section-label {
		margin: 0 0 1.25rem;
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		color: #788671;
	}

	.intro h1 {
		margin: 0 0 1.5rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.8rem, 9vw, 6rem);
		font-weight: 400;
		letter-spacing: -0.05em;
		line-height: 0.95;
		color: #304137;
	}

	.welcome {
		margin-bottom: 2rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.35rem;
		font-style: italic;
		color: #6e7d70;
	}

	.bio {
		max-width: 650px;
		margin-bottom: 0.8rem;
		font-size: 1.05rem;
		line-height: 1.9;
		color: #5f695f;
	}

	.bio strong {
		color: #3d5142;
		font-weight: 400;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.links a {
		padding: 0.65rem 1rem;
		border: 1px solid #cbd5c7;
		border-radius: 999px;
		color: #4b614d;
		text-decoration: none;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}

	.links a:hover {
		background: #e7eee1;
		transform: translateY(-2px);
	}

	/* Divider */

	.divider {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 5rem;
		color: #91a08a;
	}

	.divider::before,
	.divider::after {
		flex: 1;
		height: 1px;
		background: #d7ded2;
		content: "";
	}

	/* General */

	h2 {
		margin: 0 0 1.5rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 2.2rem;
		font-weight: 400;
		letter-spacing: -0.03em;
		color: #35463a;
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: 1rem;
		font-weight: 500;
		color: #405244;
	}

	section > p:not(.section-label) {
		max-width: 680px;
		line-height: 1.9;
		color: #626b62;
	}

	/* Education */

	.timeline {
		border-left: 1px solid #ccd6c7;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 2rem;
		padding: 0 0 2.5rem 2rem;
		position: relative;
	}

	.timeline-item::before {
		position: absolute;
		left: -5px;
		top: 0.4rem;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #82967b;
		content: "";
	}

	.timeline-item:last-child {
		padding-bottom: 0;
	}

	.time {
		font-size: 0.82rem;
		color: #899387;
	}

	.timeline-item p {
		margin: 0;
		color: #747d73;
	}

	/* Interests */

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.tags span {
		padding: 0.6rem 1rem;
		border-radius: 999px;
		background: #e7eee1;
		color: #5b6e57;
		font-size: 0.85rem;
	}

	.tags span:nth-child(2n) {
		background: #edf0e8;
	}

	.tags span:nth-child(3n) {
		background: #ece6d9;
		color: #75654d;
	}

	/* Projects */

	.project-card {
		display: grid;
		grid-template-columns: 70px 1fr;
		gap: 1.5rem;
		padding: 2rem;
		background: #f0f3ec;
		border: 1px solid #dce4d7;
		border-radius: 16px;
	}

	.project-number {
		font-family: Georgia, serif;
		font-size: 1.8rem;
		color: #84967e;
	}

	.project-card p {
		margin: 0;
		line-height: 1.8;
		color: #70796f;
	}

	/* Closing */

	.closing {
		margin-bottom: 0;
		padding-top: 3rem;
		text-align: center;
	}

	.closing p {
		margin-bottom: 1rem;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.4rem;
		font-style: italic;
		color: #61705f;
	}

	.closing a {
		color: #4c634f;
		text-decoration: none;
	}

	.closing a:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	/* Mobile */

	@media (max-width: 700px) {
		main {
			margin: 0;
			padding: 4rem 1.5rem 5rem;
			border: none;
			border-radius: 0;
			box-shadow: none;
		}

		section {
			margin-bottom: 4rem;
		}

		.timeline-item {
			grid-template-columns: 1fr;
			gap: 0.6rem;
			padding-left: 1.5rem;
		}

		.project-card {
			grid-template-columns: 1fr;
		}

		.intro h1 {
			font-size: 4rem;
		}
	}
</style>